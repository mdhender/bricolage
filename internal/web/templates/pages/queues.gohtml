{{define "content"}}
<h1>Queues</h1>
<p class="sub">A queue is a named question about the document table. There is no second query behind one: the service turns the definition into the same filter a document list uses.</p>
<div class="card">
  <table>
    <thead><tr><th>Queue</th><th>Question</th><th>Waiting</th></tr></thead>
    <tbody>
      {{range .Queues}}
        <tr>
          <td><a href="/queues/{{.Queue.Slug}}">{{.Queue.Name}}</a><br><span class="muted mono">{{.Queue.Slug}}</span></td>
          <td>
            {{with .Queue.State}}state <span class="pill state">{{.}}</span>{{end}}
            {{with .Queue.Assignee}}&middot; assignee <span class="mono">{{.}}</span>{{end}}
            {{if .Queue.Overdue}}&middot; <span class="pill late">overdue only</span>{{end}}
            <br><span class="muted">{{.Queue.Description}}</span>
          </td>
          <td>{{if .Err}}<span class="problem">{{.Err}}</span>{{else}}{{.Count}}{{end}}</td>
        </tr>
      {{else}}
        <tr><td colspan="3" class="empty">this server was started with no saved queues</td></tr>
      {{end}}
    </tbody>
  </table>
</div>
{{end}}
